#!/usr/bin/env bash
set -euo pipefail
repo_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
export SCRATCHPAD_FILE="${XDG_DATA_HOME:-$HOME/.local/share}/quickshell-scratchpad/scratchpads.json"
mkdir -p -- "$(dirname -- "$SCRATCHPAD_FILE")"
chmod 700 -- "$(dirname -- "$SCRATCHPAD_FILE")"
exec 9>"${XDG_RUNTIME_DIR:-/tmp}/quickshell-scratchpad-${UID}.lock"
flock 9
# Preserve the original text file while migrating it into the first scratchpad.
if [[ ! -e "$SCRATCHPAD_FILE" ]]; then
    python3 - <<'PYTHON'
import json, os
from pathlib import Path
path = Path(os.environ["SCRATCHPAD_FILE"])
legacy = path.with_name("scratchpad.txt")
data = {"version": 1, "activeIndex": 0, "pads": [{"name": "Scratchpad 1", "text": legacy.read_text() if legacy.exists() else ""}]}
with open(path, "x", opener=lambda name, flags: os.open(name, flags, 0o600)) as file:
    json.dump(data, file, indent=2)
PYTHON
fi

# Decide using the compositor workspace, rather than QML visibility (which
# remains true even when the window is on another workspace).
workspace=$(hyprctl -j activeworkspace | jq -r '.name')
workspace_lua=$(jq -Rn --arg workspace "$workspace" '$workspace')
find_window() {
    hyprctl -j clients | jq -r '.[] | select(.class == "org.quickshell" and .title == "Scratchpad" and .mapped) | [.address, .workspace.name] | @tsv' | head -n 1
}
move_and_focus() {
    IFS=$'\t' read -r address window_workspace < <(find_window) || true
    if [[ -n "${address:-}" ]]; then
        hyprctl dispatch "hl.dsp.window.move({workspace = $workspace_lua, window = \"address:$address\", follow = false})" >/dev/null
        hyprctl dispatch "hl.dsp.focus({window = \"address:$address\"})" >/dev/null
        return 0
    fi
    return 1
}

IFS=$'\t' read -r address window_workspace < <(find_window) || true
if [[ -n "${address:-}" && "$window_workspace" == "$workspace" ]]; then
    quickshell ipc -p "$repo_dir" call scratchpad conceal
    exit 0
fi

reveal() {
    quickshell ipc -p "$repo_dir" call scratchpad reveal >/dev/null 2>&1
}

start_instance() {
    quickshell -p "$repo_dir" --no-duplicate --daemonize 9>&-
    for ((attempt = 0; attempt < 50; attempt++)); do
        if reveal; then
            return 0
        fi
        sleep 0.1
    done
    echo "Scratchpad IPC did not become ready" >&2
    exit 1
}

if ! reveal; then
    start_instance
fi

# Mapping is asynchronous. Wait for the window before moving and focusing it.
for ((attempt = 0; attempt < 50; attempt++)); do
    if move_and_focus; then
        exit 0
    fi
    sleep 0.1
done

# The instance answered the IPC call but never mapped a window: its render
# side is wedged (seen 2026-10-15), and every further press would keep
# failing forever. Restart it once and try again.
echo "Scratchpad window did not map; restarting wedged instance" >&2
pkill -f "^quickshell( -n)? -p $repo_dir( |$)" || true
sleep 0.3
start_instance
for ((attempt = 0; attempt < 50; attempt++)); do
    if move_and_focus; then
        exit 0
    fi
    sleep 0.1
done
echo "Scratchpad window did not map" >&2
exit 1
